{
  "name": "@foreman-kit/foreman",
  "version": "0.1.0",
  "description": "Local task layer for AI coding agents working in parallel git worktrees",
  "license": "MIT",
  "type": "module",
  "bin": {
    "foreman": "src/cli.ts",
    "fm": "src/cli.ts"
  },
  "exports": {
    ".": "./src/core.ts"
  },
  "files": [
    "src",
    "templates",
    "kit",
    "scripts/bundle-kit.ts",
    "README.md",
    "KIT.md"
  ],
  "scripts": {
    "prepack": "bun scripts/bundle-kit.ts",
    "postpack": "bun scripts/bundle-kit.ts --clean"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.7"
  }
}
